{
  "type": "object",
  "properties": {
    "format": {
      "const": "proposal-nav"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "request": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "overview": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "architecture": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "summary",
        "architecture",
        "questions"
      ],
      "additionalProperties": false
    },
    "base_commit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}([0-9a-fA-F]{24})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "annotations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/annotation"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "format",
    "version",
    "id",
    "revision",
    "title",
    "request",
    "overview",
    "base_commit",
    "annotations"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proposal-nav:proposal:1",
  "title": "Proposal Nav proposal v1",
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\:\\u0000-\\u001f]+$"
    },
    "anchor": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "context": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "line",
        "context"
      ],
      "additionalProperties": false
    },
    "annotation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "operation": {
          "enum": [
            "insert_before",
            "insert_after",
            "replace",
            "delete",
            "create_file"
          ]
        },
        "target": {
          "oneOf": [
            {
              "$ref": "#/$defs/anchor"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "$ref": "#/$defs/path"
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            }
          ]
        },
        "intent": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "related": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "annotation"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "annotation_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                  }
                },
                "required": [
                  "type",
                  "label",
                  "annotation_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "code"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "target": {
                    "$ref": "#/$defs/anchor"
                  }
                },
                "required": [
                  "type",
                  "label",
                  "target"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "id",
        "title",
        "operation",
        "target",
        "intent",
        "rationale",
        "alternatives",
        "related"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "const": "create_file"
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "type": "object",
                "properties": {
                  "path": {
                    "$ref": "#/$defs/path"
                  }
                },
                "required": [
                  "path"
                ],
                "additionalProperties": false
              }
            }
          },
          "else": {
            "properties": {
              "target": {
                "$ref": "#/$defs/anchor"
              }
            }
          }
        }
      ]
    }
  }
}
