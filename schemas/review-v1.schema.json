{
  "type": "object",
  "properties": {
    "format": {
      "const": "proposal-nav-review"
    },
    "version": {
      "const": 1
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "proposal_revision": {
      "type": "integer",
      "minimum": 1
    },
    "proposal_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "approved": {
      "type": "boolean"
    },
    "annotations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "status": {
            "enum": [
              "pending",
              "reviewed",
              "flagged"
            ]
          },
          "comments": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "required": [
          "id",
          "status",
          "comments"
        ],
        "additionalProperties": false
      }
    },
    "source_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "format",
    "version",
    "proposal_id",
    "proposal_revision",
    "proposal_digest",
    "approved",
    "annotations",
    "source_digest"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proposal-nav:review:1",
  "title": "Proposal Nav feedback v1"
}
